<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primaryBlue</item>
        <item name="colorPrimaryDark">@color/navyDeep</item>
        <item name="colorAccent">@color/accentOrange</item>
        <item name="android:windowBackground">@color/pageBackground</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/navyDeep</item>
        <item name="android:navigationBarColor">@color/surfaceWhite</item>
    </style>

    <style name="PremiumCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surfaceWhite</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardUseCompatPadding">true</item>
    </style>

    <style name="PremiumInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/primaryBlue</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="hintTextColor">@color/primaryBlue</item>
        <item name="boxBackgroundColor">@color/inputBg</item>
    </style>

    <style name="PremiumButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textStyle">bold</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="TextTitle">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <style name="TextSubtitle">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/textSecondary</item>
    </style>

    <style name="GradientButton" parent="@style/PremiumButton" />
    <style name="OutlinedInput" parent="@style/PremiumInput" />
</resources>
